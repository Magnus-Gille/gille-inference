{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomy-owner-authorization/v1/schema.json",
  "title": "Grimnir owner authorization v1",
  "description": "Offline-verifiable Ed25519 owner authorization. The private key is never a repository artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "authorization_id", "authorization_sequence", "previous_authorization_digest", "issued_at", "authority", "bindings", "signature"],
  "properties": {
    "kind": { "const": "autonomy-owner-authorization" },
    "schema_version": { "const": "v1" },
    "authorization_id": { "$ref": "#/$defs/id" },
    "authorization_sequence": { "type": "integer", "minimum": 1 },
    "previous_authorization_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "issued_at": { "$ref": "#/$defs/utc" },
    "authority": { "$ref": "#/$defs/authority" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time" },
    "pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----\\n(?:[A-Za-z0-9+/=]+\\n)+-----END PUBLIC KEY-----\\n?$" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["key_id", "algorithm", "public_key_pem", "public_key_fingerprint"], "properties": { "key_id": { "$ref": "#/$defs/id" }, "algorithm": { "const": "Ed25519" }, "public_key_pem": { "$ref": "#/$defs/pem" }, "public_key_fingerprint": { "$ref": "#/$defs/digest" } } },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["constitution_digest", "coverage_intent_digest", "owner_attestation_registry_digest", "recovery_worker_registry_digest"], "properties": { "constitution_digest": { "$ref": "#/$defs/digest" }, "coverage_intent_digest": { "$ref": "#/$defs/digest" }, "owner_attestation_registry_digest": { "$ref": "#/$defs/digest" }, "recovery_worker_registry_digest": { "$ref": "#/$defs/digest" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "value_base64"], "properties": { "algorithm": { "const": "Ed25519" }, "value_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" } } }
  }
}
