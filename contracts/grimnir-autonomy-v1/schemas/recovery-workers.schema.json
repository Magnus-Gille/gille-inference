{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomy-recovery-worker-registry/v1/schema.json",
  "title": "Grimnir recovery-worker verification keys v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schema_version", "registry_id", "entries", "registry_digest", "extensions"],
  "properties": { "kind": { "const": "autonomy-recovery-worker-registry" }, "schema_version": { "const": "v1" }, "registry_id": { "$ref": "#/$defs/id" }, "entries": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/entry" } }, "registry_digest": { "$ref": "#/$defs/digest" }, "extensions": { "type": "array", "maxItems": 0 } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "pem": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----\\n(?:[A-Za-z0-9+/=]+\\n)+-----END PUBLIC KEY-----\\n?$" }, "entry": { "type": "object", "additionalProperties": false, "required": ["domain", "target_scope_digest", "recovery_worker_identity", "public_key_pem", "public_key_fingerprint"], "properties": { "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "target_scope_digest": { "$ref": "#/$defs/digest" }, "recovery_worker_identity": { "$ref": "#/$defs/id" }, "public_key_pem": { "$ref": "#/$defs/pem" }, "public_key_fingerprint": { "$ref": "#/$defs/digest" } } } }
}
