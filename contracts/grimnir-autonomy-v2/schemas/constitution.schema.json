{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomy-constitution/v2/schema.json",
  "title": "Grimnir autonomy constitution v2",
  "description": "Closed, digest-bound W0.2 constitutional floor with mechanically reachable post-mutation watch timing. It is a contract only; W0.2 is disarmed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "constitution_id", "issued_at", "promotion_mode", "protected_lanes", "safety_floors", "autonomous_classes", "constitution_digest", "extensions"],
  "properties": {
    "kind": { "const": "autonomy-constitution" },
    "schema_version": { "const": "v2" },
    "constitution_id": { "$ref": "#/$defs/id" },
    "issued_at": { "$ref": "#/$defs/utc" },
    "promotion_mode": { "const": "mechanical-for-covered-classes-only" },
    "protected_lanes": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "enum": ["credentials-and-auth", "owner-policy", "constitution-and-safety-gates", "deployments-and-code", "privacy-retention-and-erasure", "firmware", "remote-recovery", "model-weight-training", "irreversible-external-actions", "package-downgrade"] } },
    "safety_floors": { "$ref": "#/$defs/safety-floors" },
    "autonomous_classes": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "oneOf": [{ "$ref": "#/$defs/micro-routing" }, { "$ref": "#/$defs/macro-routing" }, { "$ref": "#/$defs/prompt" }, { "$ref": "#/$defs/harness" }, { "$ref": "#/$defs/tool-policy" }, { "$ref": "#/$defs/served-model-roster" }, { "$ref": "#/$defs/maintenance" }] } },
    "constitution_digest": { "$ref": "#/$defs/digest" },
    "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time" },
    "levels": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["L4", "L5"] } },
    "identity-roles": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["owner", "controller", "watchdog", "kill-switch", "recovery-worker"] } },
    "success-postconditions": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["verifier-passes", "canary-watch-complete", "micro-route-readback-matches-candidate", "macro-route-readback-matches-candidate", "prompt-config-readback-matches-candidate", "harness-config-readback-matches-candidate", "tool-policy-readback-matches-candidate", "served-model-roster-readback-matches-candidate", "maintenance-safe-state-readback"] } },
    "recovery-postconditions": { "type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["baseline-digest-restored", "safe-state-verified", "quarantine-active", "coverage-demoted-to-shadow", "recovery-worker-disarm-confirmed"] } },
    "fault-injection": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "enum": ["executor-interruption", "observer-cannot-actuate", "recovery-path-proven", "recovery-failure-disarms", "stale-evidence-rejected", "chain-tamper-rejected", "canary-breach-quarantines", "late-mutation-rejected", "kill-switch-rejected"] } },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["max_concurrent_targets", "canary_only_until_armed_fleet", "apply_verify_budget_seconds", "minimum_watch_seconds", "commit_grace_seconds", "deadline_seconds", "max_attempts", "min_seconds_between_attempts", "max_attempts_per_window", "attempt_window_seconds", "max_silence_seconds", "trusted_watchdog_time_required"], "properties": { "max_concurrent_targets": { "type": "integer", "minimum": 1, "maximum": 1 }, "canary_only_until_armed_fleet": { "const": true }, "apply_verify_budget_seconds": { "const": 300 }, "minimum_watch_seconds": { "const": 3600 }, "commit_grace_seconds": { "const": 300 }, "deadline_seconds": { "const": 4200 }, "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1 }, "min_seconds_between_attempts": { "type": "integer", "minimum": 60, "maximum": 2592000 }, "max_attempts_per_window": { "type": "integer", "minimum": 1, "maximum": 1 }, "attempt_window_seconds": { "type": "integer", "minimum": 60, "maximum": 2592000 }, "max_silence_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }, "trusted_watchdog_time_required": { "const": true } } },
    "safety-floors": { "type": "object", "additionalProperties": false, "required": ["fail_closed", "kill_switch", "fresh_evidence", "unique_identity", "content_blind_journal", "observer_cannot_actuate", "unknown_disarms", "success_preserves_arming", "recovery_worker_disarms", "coverage_widening_owner_controlled", "recovery_worker_may_only_narrow", "protected_lanes_never_promote"], "properties": { "fail_closed": { "const": true }, "kill_switch": { "const": true }, "fresh_evidence": { "const": true }, "unique_identity": { "const": true }, "content_blind_journal": { "const": true }, "observer_cannot_actuate": { "const": true }, "unknown_disarms": { "const": true }, "success_preserves_arming": { "const": true }, "recovery_worker_disarms": { "const": true }, "coverage_widening_owner_controlled": { "const": true }, "recovery_worker_may_only_narrow": { "const": true }, "protected_lanes_never_promote": { "const": true } } },
    "class-common": { "type": "object", "additionalProperties": false, "required": ["class", "required_for_levels", "owner_scope", "owner", "owner_binding_source", "admission", "recovery_class", "bounds", "required_identity_roles", "success_postconditions", "recovery_postconditions", "fault_injection_requirements"], "properties": { "class": { "type": "string" }, "required_for_levels": { "$ref": "#/$defs/levels" }, "owner_scope": { "enum": ["fixed-component", "owning-component"] }, "owner": { "enum": ["hugin", "gille-inference", "brokkr", "owning-component"] }, "owner_binding_source": { "const": "owner-controlled-coverage-registry" }, "admission": { "const": "mechanical-after-all-predicates" }, "recovery_class": { "enum": ["R-exact", "R-forward"] }, "bounds": { "$ref": "#/$defs/bounds" }, "required_identity_roles": { "$ref": "#/$defs/identity-roles" }, "success_postconditions": { "$ref": "#/$defs/success-postconditions" }, "recovery_postconditions": { "$ref": "#/$defs/recovery-postconditions" }, "fault_injection_requirements": { "$ref": "#/$defs/fault-injection" } } },
    "micro-routing": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "micro-routing" }, "required_for_levels": { "const": ["L4", "L5"] }, "owner_scope": { "const": "fixed-component" }, "owner": { "const": "gille-inference" }, "recovery_class": { "const": "R-exact" } } }] },
    "macro-routing": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "macro-routing" }, "required_for_levels": { "const": ["L5"] }, "owner_scope": { "const": "fixed-component" }, "owner": { "const": "hugin" }, "recovery_class": { "const": "R-exact" } } }] },
    "prompt": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "prompt" }, "required_for_levels": { "const": ["L5"] }, "owner_scope": { "const": "owning-component" }, "owner": { "const": "owning-component" }, "recovery_class": { "const": "R-exact" } } }] },
    "harness": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "harness" }, "required_for_levels": { "const": ["L5"] }, "owner_scope": { "const": "owning-component" }, "owner": { "const": "owning-component" }, "recovery_class": { "const": "R-exact" } } }] },
    "tool-policy": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "tool-policy" }, "required_for_levels": { "const": ["L5"] }, "owner_scope": { "const": "owning-component" }, "owner": { "const": "owning-component" }, "recovery_class": { "const": "R-exact" } } }] },
    "served-model-roster": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "served-model-roster" }, "required_for_levels": { "const": ["L5"] }, "owner_scope": { "const": "fixed-component" }, "owner": { "const": "gille-inference" }, "recovery_class": { "const": "R-exact" } } }] },
    "maintenance": { "allOf": [{ "$ref": "#/$defs/class-common" }, { "type": "object", "properties": { "class": { "const": "no-reboot-security-bugfix-maintenance" }, "required_for_levels": { "const": ["L4"] }, "owner_scope": { "const": "fixed-component" }, "owner": { "const": "brokkr" }, "recovery_class": { "const": "R-forward" } } }] }
  }
}
