{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomous-mutation-journal/v2/schema.json",
  "title": "Grimnir autonomous mutation journal v2",
  "description": "One authoritative, content-blind, append-only ADR-008 domain journal. The durable authenticated watch receipt starts the derived watch interval. Semantic checks are normative in tests/scripts/validate-autonomy-contract-v2.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "journal_id", "domain", "constitution_digest", "binding", "binding_digest", "entries", "extensions"],
  "properties": {
    "kind": { "const": "autonomous-mutation-journal" },
    "schema_version": { "const": "v2" },
    "journal_id": { "$ref": "#/$defs/id" },
    "domain": { "enum": ["micro-routing", "macro-routing", "prompt", "harness", "tool-policy", "served-model-roster", "no-reboot-security-bugfix-maintenance"] },
    "constitution_digest": { "$ref": "#/$defs/digest" },
    "binding": { "$ref": "#/$defs/binding" },
    "binding_digest": { "$ref": "#/$defs/digest" },
    "entries": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/entry" } },
    "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time" },
    "opaque-ref": { "type": "string", "pattern": "^ref:[a-z][a-z0-9-]{2,120}$" },
    "nullable-digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "nullable-coverage-transition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/coverage-transition" }] },
    "recovery": { "type": "object", "additionalProperties": false, "required": ["class", "worker_identity", "descriptor_digest", "disarms_after_action"], "properties": { "class": { "enum": ["R-exact", "R-forward"] }, "worker_identity": { "$ref": "#/$defs/id" }, "descriptor_digest": { "$ref": "#/$defs/digest" }, "disarms_after_action": { "const": true } } },
    "canary": { "type": "object", "additionalProperties": false, "required": ["scope_digest", "target_count"], "properties": { "scope_digest": { "$ref": "#/$defs/digest" }, "target_count": { "type": "integer", "minimum": 1, "maximum": 1 } } },
    "quarantine": { "type": "object", "additionalProperties": false, "required": ["state", "reason_digest"], "properties": { "state": { "enum": ["not-applicable", "active"] }, "reason_digest": { "$ref": "#/$defs/digest" } } },
    "coverage-transition": { "type": "object", "additionalProperties": false, "required": ["from_state", "to_state", "target_scope_digest", "actor_identity"], "properties": { "from_state": { "enum": ["armed-canary", "armed-fleet"] }, "to_state": { "const": "shadow" }, "target_scope_digest": { "$ref": "#/$defs/digest" }, "actor_identity": { "$ref": "#/$defs/id" } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["mutation_id", "attempt_id", "recovery_disarm_id", "idempotency_key", "writer_owner", "owner_authority_ref", "owner_authority_digest", "configuration_owner", "configuration_owner_authority_ref", "configuration_owner_authority_digest", "target_scope_digest", "admission_coverage_digest", "admission_binding_state", "owner_identity", "controller_identity", "watchdog_identity", "kill_switch_identity", "recovery_worker_identity", "risk_scope", "candidate_digest", "config_digest", "evidence_digest", "policy_digest", "baseline_digest", "postconditions_digest", "deadline", "canary", "recovery"], "properties": {
      "mutation_id": { "$ref": "#/$defs/id" },
      "attempt_id": { "$ref": "#/$defs/id" },
      "recovery_disarm_id": { "$ref": "#/$defs/id" },
      "idempotency_key": { "$ref": "#/$defs/id" },
      "writer_owner": { "$ref": "#/$defs/id" },
      "owner_authority_ref": { "$ref": "#/$defs/opaque-ref" },
      "owner_authority_digest": { "$ref": "#/$defs/digest" },
      "configuration_owner": { "$ref": "#/$defs/id" },
      "configuration_owner_authority_ref": { "$ref": "#/$defs/opaque-ref" },
      "configuration_owner_authority_digest": { "$ref": "#/$defs/digest" },
      "target_scope_digest": { "$ref": "#/$defs/digest" },
      "admission_coverage_digest": { "$ref": "#/$defs/digest" },
      "admission_binding_state": { "enum": ["armed-canary", "armed-fleet"] },
      "owner_identity": { "$ref": "#/$defs/id" },
      "controller_identity": { "$ref": "#/$defs/id" },
      "watchdog_identity": { "$ref": "#/$defs/id" },
      "kill_switch_identity": { "$ref": "#/$defs/id" },
      "recovery_worker_identity": { "$ref": "#/$defs/id" },
      "risk_scope": { "$ref": "#/$defs/id" },
      "candidate_digest": { "$ref": "#/$defs/digest" },
      "config_digest": { "$ref": "#/$defs/digest" },
      "evidence_digest": { "$ref": "#/$defs/digest" },
      "policy_digest": { "$ref": "#/$defs/digest" },
      "baseline_digest": { "$ref": "#/$defs/digest" },
      "postconditions_digest": { "$ref": "#/$defs/digest" },
      "deadline": { "$ref": "#/$defs/utc" },
      "canary": { "$ref": "#/$defs/canary" },
      "recovery": { "$ref": "#/$defs/recovery" }
    } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["entry_id", "sequence", "recorded_at", "phase", "outcome", "executor_identity", "binding_digest", "quarantine", "coverage_transition", "terminal_reason_digest", "previous_receipt_digest", "receipt_digest", "content_refs"], "properties": {
      "entry_id": { "$ref": "#/$defs/id" },
      "sequence": { "type": "integer", "minimum": 1 },
      "recorded_at": { "$ref": "#/$defs/utc" },
      "phase": { "enum": ["prepare", "apply", "verify", "watch", "commit", "unknown", "revert", "recover", "quarantine", "disarm", "terminally-blocked"] },
      "outcome": { "enum": ["prepared", "applied", "verified", "watching", "committed", "unknown", "reverted", "recovered", "quarantined", "disarmed", "terminally-blocked"] },
      "executor_identity": { "$ref": "#/$defs/id" },
      "binding_digest": { "$ref": "#/$defs/digest" },
      "quarantine": { "$ref": "#/$defs/quarantine" },
      "coverage_transition": { "$ref": "#/$defs/nullable-coverage-transition" },
      "terminal_reason_digest": { "$ref": "#/$defs/nullable-digest" },
      "previous_receipt_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
      "receipt_digest": { "$ref": "#/$defs/digest" },
      "content_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/opaque-ref" } }
    } }
  }
}
