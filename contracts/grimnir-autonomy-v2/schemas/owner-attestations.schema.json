{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimnir.gille.ai/contracts/autonomy-owner-attestation-registry/v1/schema.json",
  "title": "Grimnir autonomous target-owner attestation registry v1",
  "description": "Owner-controlled, digest-bound target/configuration ownership root used by ADR-008 coverage admission. It grants no arming state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "registry_id", "issued_at", "issuer_identity", "mutation_policy", "attestations", "registry_digest", "extensions"],
  "properties": {
    "kind": { "const": "autonomy-owner-attestation-registry" },
    "schema_version": { "const": "v1" },
    "registry_id": { "$ref": "#/$defs/id" },
    "issued_at": { "$ref": "#/$defs/utc" },
    "issuer_identity": { "const": "grimnir-owner" },
    "mutation_policy": { "const": "owner-controlled-protected-lane" },
    "attestations": { "type": "array", "minItems": 4, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/attestation" } },
    "registry_digest": { "$ref": "#/$defs/digest" },
    "extensions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,120}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_id", "domain", "target_scope_digest", "configuration_owner", "issued_at", "attestation_digest"],
      "properties": {
        "attestation_id": { "$ref": "#/$defs/id" },
        "domain": { "enum": ["micro-routing", "macro-routing", "prompt", "harness", "tool-policy", "served-model-roster", "no-reboot-security-bugfix-maintenance"] },
        "target_scope_digest": { "$ref": "#/$defs/digest" },
        "configuration_owner": { "$ref": "#/$defs/id" },
        "issued_at": { "$ref": "#/$defs/utc" },
        "attestation_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
