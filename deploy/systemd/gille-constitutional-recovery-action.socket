[Unit]
Description=Watchdog-only constitutional recovery action capability

[Socket]
ListenStream=/run/gille-inference/autonomy/recovery-action.sock
FileDescriptorName=action
SocketUser=gille-autonomy-recovery
SocketGroup=gille-autonomy-watchdog
SocketMode=0660
DirectoryMode=0755
Service=gille-constitutional-recovery.service

[Install]
WantedBy=sockets.target
